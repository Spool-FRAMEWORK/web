---
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHeader from '../components/landing/LandingHeader.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import Hero from '../components/landing/Hero.astro';
import TraceViewer from '../components/landing/TraceViewer.astro';
import Story from '../components/landing/Story.astro';
import Descriptor from '../components/landing/Descriptor.astro';
import UseCase from '../components/landing/UseCase.astro';
import GetStarted from '../components/landing/GetStarted.astro';
import { site } from '../data/site';
---

<LandingLayout title={`${site.name}, data pipelines you can trace`} description={site.description}>
	<LandingHeader />
	<main id="main">
		<Hero />
		<TraceViewer />
		<Story />
		<div class="band">
			<Descriptor />
		</div>
		<UseCase />
	</main>
	<div class="ink-band">
		<GetStarted />
		<LandingFooter />
	</div>
</LandingLayout>

<style>
	.band {
		background: var(--landing-band);
	}

	.ink-band {
		background: var(--landing-ink);
		color: var(--landing-on-ink);
	}
</style>
