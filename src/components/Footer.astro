---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import { site, withBase } from '../data/site';
import { brand } from '../data/brand';

const documentationLinks = [
	{ label: 'Install', href: withBase('getting-started/') },
	{ label: 'Build your first pipeline', href: withBase('getting-started/first-pipeline/') },
	{ label: 'Modules', href: withBase('modules/') },
	{ label: 'Descriptor reference', href: withBase('dsl/') },
];

const projectLinks = [
	{ label: 'Source code on GitHub', href: site.githubUrl },
	{ label: 'Example pipelines', href: site.examplesUrl },
	{ label: 'Maven Central', href: site.mavenCentralUrl },
];

const year = new Date().getFullYear();
---

<DefaultFooter />

<div class="site-footer">
	<div class="columns">
		<div class="about">
			<a class="brand" href={withBase('')}>{brand.wordmark}</a>
			<p>Created by {site.author} as a {site.origin}.</p>
		</div>
		<nav aria-label="Documentation">
			<h2>Documentation</h2>
			{documentationLinks.map((link) => <a href={link.href}>{link.label}</a>)}
		</nav>
		<nav aria-label="Project">
			<h2>Project</h2>
			{projectLinks.map((link) => <a href={link.href}>{link.label}</a>)}
		</nav>
	</div>
	<div class="legal">
		<span>© {year} {site.author}</span>
		<span>Released under the <a href={withBase(site.license.pagePath)}>{site.license.name}</a></span>
	</div>
</div>

<style>
	.site-footer {
		--footer-background: var(--spool-header-background);
		--footer-text: #aab3bf;
		--footer-heading: #ffffff;
		--footer-link: #d5dbe3;
		--footer-rule: #2f3946;
		margin-top: 4rem;
		padding-block: 2.5rem 2rem;
		background-color: var(--footer-background);
		box-shadow: 0 0 0 100vmax var(--footer-background);
		clip-path: inset(0 -100vmax);
		position: relative;
		z-index: 2;
		color: var(--footer-text);
		font-size: var(--sl-text-sm);
	}
	:global([data-has-sidebar]) .site-footer {
		--footer-background: var(--sl-color-bg-nav);
		--footer-text: var(--sl-color-gray-3);
		--footer-heading: var(--sl-color-white);
		--footer-link: var(--sl-color-gray-2);
		--footer-rule: var(--sl-color-hairline-light);
		padding-inline: 1.5rem;
		border-top: 1px solid var(--footer-rule);
		box-shadow: none;
		clip-path: none;
	}
	.columns {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem 3rem;
	}
	.about {
		flex: 2 1 16rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.about p {
		margin: 0;
		max-width: 28rem;
		line-height: 1.6;
	}
	.brand {
		color: var(--footer-heading);
		font-size: var(--sl-text-xl);
		font-weight: 700;
		text-decoration: none;
	}
	nav {
		flex: 1 1 10rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	h2 {
		margin: 0 0 0.25rem;
		color: var(--footer-heading);
		font-size: var(--sl-text-sm);
		font-weight: 600;
	}
	a {
		color: var(--footer-link);
		text-decoration: none;
	}
	a:hover {
		color: var(--footer-heading);
		text-decoration: underline;
	}
	.legal {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		margin-top: 2rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--footer-rule);
	}
	.legal a {
		text-decoration: underline;
	}
</style>
