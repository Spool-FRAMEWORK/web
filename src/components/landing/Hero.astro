---
import { cliInstallScripts, site, withBase } from '../../data/site';
import { latestRelease } from '../../data/release';

const scriptUrl = (script: string) => new URL(withBase(script), Astro.site ?? Astro.url).href;
const commands = {
	unix: { prompt: '$', command: `curl -fsSL ${scriptUrl(cliInstallScripts.unix)} | sh` },
	windows: { prompt: 'PS>', command: `irm ${scriptUrl(cliInstallScripts.windows)} | iex` },
};
---

<section class="hero wrap">
	<a class="release" href={withBase('getting-started/')}>
		<span class="release-tag">New</span>Release {latestRelease.version}
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
	</a>
	<h1>{site.headline}</h1>
	<p class="lead">Spool is a Java framework where every record leaves a trail, from the source to your data mart.</p>

	<div id="install" class="install" data-install data-unix={JSON.stringify(commands.unix)} data-windows={JSON.stringify(commands.windows)}>
		<a class="button button-primary" href={withBase('getting-started/')}>
			Get started
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
		</a>
		<span class="command">
			<code><span class="prompt" data-prompt>{commands.unix.prompt} </span><span data-command>{commands.unix.command}</span></code>
			<button type="button" class="copy" data-copy aria-label="Copy the install command">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"></rect><path d="M4 16V6a2 2 0 0 1 2-2h10"></path></svg>
				<span data-copy-label>Copy</span>
			</button>
		</span>
	</div>

	<div class="install-options">
		<div class="systems" role="group" aria-label="Operating system">
			<button type="button" data-system="unix" aria-pressed="true">macOS / Linux</button>
			<button type="button" data-system="windows" aria-pressed="false">Windows</button>
		</div>
		<span>Free software under the <a href={withBase(site.license.pagePath)}>AGPL 3.0</a>, for Java {site.requiredJavaVersion} and later.</span>
	</div>
</section>

<script>
	const install = document.querySelector<HTMLElement>('[data-install]');
	if (install) {
		const systems = { unix: JSON.parse(install.dataset.unix ?? '{}'), windows: JSON.parse(install.dataset.windows ?? '{}') };
		const prompt = install.querySelector<HTMLElement>('[data-prompt]')!;
		const command = install.querySelector<HTMLElement>('[data-command]')!;
		const copyLabel = install.querySelector<HTMLElement>('[data-copy-label]')!;
		const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-system]')];
		const copiedMilliseconds = 1600;
		let current: keyof typeof systems = 'unix';
		let resetTimer: number | undefined;

		buttons.forEach((button) =>
			button.addEventListener('click', () => {
				current = button.dataset.system as keyof typeof systems;
				prompt.textContent = `${systems[current].prompt} `;
				command.textContent = systems[current].command;
				copyLabel.textContent = 'Copy';
				buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
			}),
		);

		install.querySelector<HTMLButtonElement>('[data-copy]')!.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(systems[current].command);
				copyLabel.textContent = 'Copied';
			} catch {
				copyLabel.textContent = 'Select and copy';
			}
			window.clearTimeout(resetTimer);
			resetTimer = window.setTimeout(() => (copyLabel.textContent = 'Copy'), copiedMilliseconds);
		});
	}
</script>

<style>
	.hero {
		padding-top: 88px;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 26px;
	}

	.release {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 5px 14px 5px 5px;
		border: 1px solid var(--landing-border);
		border-radius: 999px;
		background: #ffffff;
		color: var(--landing-ink);
		font-size: 14px;
		text-decoration: none;
	}

	.release-tag {
		padding: 2px 10px;
		border-radius: 999px;
		background: var(--landing-blue-tint);
		color: var(--landing-blue-dark);
		font-weight: 600;
	}

	h1 {
		margin: 0;
		max-width: 940px;
		font-family: var(--landing-display);
		font-size: clamp(44px, 7vw, 96px);
		line-height: 1;
		font-weight: 500;
		letter-spacing: -0.035em;
	}

	.lead {
		margin: 0;
		max-width: 620px;
		font-size: 21px;
		line-height: 1.5;
		color: var(--landing-muted);
	}

	.install {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 12px;
		padding-top: 6px;
		max-width: 100%;
	}

	.command {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		height: 52px;
		max-width: 100%;
		padding: 0 6px 0 20px;
		border-radius: 999px;
		background: #ffffff;
		border: 1px solid var(--landing-border-strong);
	}

	.command code {
		min-width: 0;
		overflow-x: auto;
		scrollbar-width: none;
		mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent);
		white-space: nowrap;
		font-size: 14px;
		color: var(--landing-ink);
	}

	.command code::-webkit-scrollbar {
		display: none;
	}

	.prompt {
		color: var(--landing-faint);
		user-select: none;
	}

	.copy {
		flex: none;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 40px;
		padding: 0 12px;
		border: 0;
		border-radius: 999px;
		background: var(--landing-band);
		color: var(--landing-ink);
		font: inherit;
		font-size: 13px;
		font-weight: 600;
		cursor: pointer;
	}

	.copy:hover {
		background: var(--landing-blue-tint);
	}

	.install-options {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 10px 16px;
		font-size: 14px;
		color: var(--landing-muted);
	}

	.systems {
		display: inline-flex;
		gap: 2px;
		padding: 3px;
		border-radius: 999px;
		background: #eef0f5;
	}

	.systems button {
		height: 32px;
		padding: 0 14px;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--landing-muted);
		font: inherit;
		font-size: 13px;
		font-weight: 500;
		cursor: pointer;
	}

	.systems button[aria-pressed='true'] {
		background: var(--landing-blue);
		color: #ffffff;
	}
</style>
