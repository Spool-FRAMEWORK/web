---
import { site, withBase } from '../../data/site';

const { groupId, artifactId, version } = site.latestRelease;
---

<section class="get-started wrap section">
	<span class="rail" aria-hidden="true"></span>
	<div class="text">
		<span class="eyebrow"><span class="knot" aria-hidden="true"></span>Get started</span>
		<h2 class="section-title">Add the runtime and follow your first record.</h2>
		<p>Spool needs Java {site.requiredJavaVersion} or later. If you prefer the terminal, the CLI installs with the one line at the <a href="#install">top of this page</a>.</p>
		<a class="button button-light" href={withBase('getting-started/first-pipeline/')}>
			Build your first pipeline
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
		</a>
	</div>
	<pre aria-label="Maven dependency">&lt;dependency&gt;
  &lt;groupId&gt;{groupId}&lt;/groupId&gt;
  &lt;artifactId&gt;{artifactId}&lt;/artifactId&gt;
  &lt;version&gt;<span class="version">{version}</span>&lt;/version&gt;
&lt;/dependency&gt;</pre>
</section>

<style>
	.get-started {
		padding-top: 104px;
		padding-bottom: 96px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 40px 64px;
	}

	.rail {
		background: linear-gradient(rgba(123, 150, 255, 0.3), var(--landing-blue-light));
	}

	.eyebrow {
		color: var(--landing-blue-pale);
	}

	.knot {
		border-color: var(--landing-blue-light);
		background: var(--landing-blue-light);
	}

	.text {
		flex: 1 1 420px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.section-title {
		color: #ffffff;
	}

	p {
		margin: 0;
		color: var(--landing-on-ink-muted);
	}

	p a {
		color: var(--landing-blue-pale);
	}

	.button-light {
		align-self: flex-start;
	}

	pre {
		flex: 1 1 420px;
		min-width: 0;
		margin: 0;
		padding: 24px;
		overflow-x: auto;
		background: var(--landing-ink-raised);
		border: 1px solid var(--landing-ink-border);
		border-radius: 20px;
		font-size: 14px;
		line-height: 1.8;
		color: var(--landing-on-ink);
	}

	.version {
		color: var(--landing-blue-pale);
	}

	.get-started :focus-visible {
		outline-color: var(--landing-blue-pale);
	}

	@media (max-width: 760px) {
		.get-started {
			padding-top: 64px;
			padding-bottom: 64px;
		}
	}
</style>
