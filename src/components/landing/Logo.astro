---
interface Props {
	size: number;
	tone: 'on-light' | 'on-dark';
}

const { size, tone } = Astro.props;
const spiral = tone === 'on-light' ? '#0D1220' : '#E8ECF6';
const thread = tone === 'on-light' ? '#1F45C8' : '#7B96FF';
---

<svg viewBox="10 -2 56 56" width={size} height={size} aria-hidden="true">
	<path d="M24 24A4 4 0 0 1 32 24A8 8 0 0 1 16 24A12 12 0 0 1 40 24" stroke={spiral} stroke-width="4" stroke-linecap="round" fill="none"></path>
	<path d="M40 24Q40 38 52 38" stroke={thread} stroke-width="4" stroke-linecap="round" fill="none"></path>
	<circle cx="57" cy="38" r="4" fill={thread}></circle>
</svg>
